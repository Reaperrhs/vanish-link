# VanishLink backend configuration
# Copy to backend/.env and fill in values

PORT=3000

# Appwrite server credentials (API key needs documents.* scope on the database)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Collection IDs
DATABASE_ID=
COLLECTION_ID=
WORKSPACES_COLLECTION_ID=
# Optional — defaults to analytics_telemetry
ANALYTICS_COLLECTION_ID=analytics_telemetry

# Public base URL used when returning short links (e.g. https://sl.example.com)
SHORT_URL_BASE=

# Set to 1 (or the number of proxy hops) when the backend sits behind a reverse
# proxy, so req.ip resolves from X-Forwarded-For. Leave unset when reachable
# directly — trusting the header then would let clients spoof their IP.
TRUST_PROXY=

# Shared secret for POST /api/sweep (sent as the x-sweep-token header).
# Optional — leave empty for an open endpoint on a private network.
SWEEP_TOKEN=

# When set, POST /api/sweep also deletes click telemetry older than this many
# days. Analytics only reads the last 7 days, so 30 is a safe value.
# Leave empty to keep logs forever.
ANALYTICS_RETENTION_DAYS=
