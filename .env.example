# VanishLink deployment configuration (docker-compose)
# Copy to .env next to docker-compose.yml on the server and fill in values.

# Host ports (host:container)
PORT_BACKEND=3000
PORT_FRONTEND=80

# Appwrite server credentials for the backend (API key needs documents.* scope)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Collection IDs
DATABASE_ID=
COLLECTION_ID=
WORKSPACES_COLLECTION_ID=
ANALYTICS_COLLECTION_ID=analytics_telemetry

# Public base URL used for short links (e.g. https://sl.example.com)
SHORT_URL_BASE=

# Set to 1 when the backend runs behind a reverse proxy (see backend/.env.example)
TRUST_PROXY=

# Sweep endpoint guard + optional telemetry retention in days (see README)
SWEEP_TOKEN=
ANALYTICS_RETENTION_DAYS=

# Frontend build-time values (baked into the SPA by the Vite build)
VITE_APPWRITE_PUBLIC_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_DATABASE_ID=
VITE_COLLECTION_ID=
VITE_API_BASE_URL=http://localhost:3000
VITE_SHORT_URL_BASE=
