# VanishLink frontend configuration (Vite — vars must be prefixed VITE_)
# Copy to frontend/.env and fill in values

# Browser-facing Appwrite endpoint (no API key — uses project ID + public perms)
VITE_APPWRITE_PUBLIC_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_DATABASE_ID=
VITE_COLLECTION_ID=

# Express backend base URL used for shorten/reset/analytics calls
VITE_API_BASE_URL=http://localhost:3000

# Base URL shown for short links (defaults to VITE_API_BASE_URL)
VITE_SHORT_URL_BASE=
